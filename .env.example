# ==============================================================================
# Al Astoora Document Collector Agent — Environment Configuration Template
# Copy this file to .env and populate with your actual credentials.
# ==============================================================================

# Meta WhatsApp Cloud API Credentials
WHATSAPP_TOKEN=your_meta_system_user_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
BOT_PHONE_NUMBER=your_bot_phone_number_here
WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here
GRAPH_API_VERSION=v26.0

# Google Cloud Platform Configuration
GCP_PROJECT_ID=your_gcp_project_id_here
GCP_LOCATION=asia-south1
GCS_BUCKET_NAME=your_gcs_bucket_name_here
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Google Calendar Integration (Optional Sync)
GOOGLE_CALENDAR_ID=
DEFAULT_TIMEZONE=Asia/Singapore

# Gemini & Agent Configuration
GEMINI_MODEL=gemini-3.7-flash
GEMINI_LOCATION=global
GEMINI_THINKING_LEVEL=low
GEMINI_THINKING_BUDGET=0

# Server & App Environment
APP_ENV=development
LOG_LEVEL=INFO
PORT=8080
